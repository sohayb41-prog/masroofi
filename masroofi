import Foundation
import SwiftData

@Model
class MoneyTransaction: Identifiable {
    var id: UUID
    var title: String
    var amount: Double
    var date: Date
    var category: String
    var isExpense: Bool

    init(id: UUID = UUID(), title: String, amount: Double, date: Date, category: String, isExpense: Bool = true) {
        self.id = id
        self.title = title
        self.amount = amount
        self.date = date
        self.category = category
        self.isExpense = isExpense
    }
}

enum TransactionCategory: String, CaseIterable, Identifiable {
    var id: String { self.rawValue }
    case food = "طعام ومشروبات"
    case bills = "فواتير وخدمات"
    case transport = "مواصلات"
    case shopping = "تسوق"
    case salary = "راتب / إيداع"
    case other = "أخرى"
}import Foundation

struct ParsedBankMessage {
    var amount: Double?
    var merchant: String?
    var date: Date?
    var isExpense: Bool
}

class BankMessageParser {
    static let shared = BankMessageParser()
    private let formatter: NumberFormatter

    private init() {
        formatter = NumberFormatter()
        formatter.locale = Locale(identifier: "en_US") // لمعالجة الأرقام القياسية والإنجليزية والعربية
    }
    
    func parse(message: String) -> ParsedBankMessage {
        var amount: Double?
        var merchant: String?
        let lowerMsg = message.lowercased()
        
        // تحديد نوع العملية بدقة
        let isExpense = !lowerMsg.contains("إيداع") && 
                        !lowerMsg.contains("رواتب") && 
                        !lowerMsg.contains("استرجاع") && 
                        !lowerMsg.contains("deposit") && 
                        !lowerMsg.contains("refund") &&
                        !lowerMsg.contains("تحويل لحسابكم")
        
        // استخراج المبلغ (يدعم SAR 150 أو 150 SAR أو ر.س أو الأرقام المجردة)
        let amountPatterns = [
            #"(?:SAR|ر\.س|رس|USD|EUR)\s*(\d+(?:[,\.]\d{1,2})?)"#,
            #"(\d+(?:[,\.]\d{1,2})?)\s*(?:SAR|ر\.س|رس)"#,
            #"(?:مبلغ|بمبلغ|بقيمة|amount:?)\s*(\d+(?:[,\.]\d{1,2})?)"#
        ]
        
        for pattern in amountPatterns {
            if let regex = try? NSRegularExpression(pattern: pattern, options: .caseInsensitive),
               let match = regex.firstMatch(in: message, options: [], range: NSRange(location: 0, length: message.utf16.count)),
               let range = Range(match.range(at: 1), in: message) {
                let rawNum = String(message[range]).replacingOccurrences(of: ",", with: ".")
                if let val = parseNumber(rawNum), val > 0 {
                    amount = val
                    break
                }
            }
        }
        
        // استخراج اسم التجر بدقة مع حدود الكلمات \b
        let merchantPatterns = [
            #"\b(?:لدى|من|عند|في|at|to)\s+([^\p{Z}\n\.,]+(?:\s+[^\p{Z}\n\.,]+){0,2})"#,
            #"(?:المتجر|التاجر|Merchant):?\s*([^\n\.,]+)"#
        ]
        
        for pattern in merchantPatterns {
            if let regex = try? NSRegularExpression(pattern: pattern, options: .caseInsensitive),
               let match = regex.firstMatch(in: message, options: [], range: NSRange(location: 0, length: message.utf16.count)),
               let range = Range(match.range(at: 1), in: message) {
                let extracted = String(message[range]).trimmingCharacters(in: .whitespacesAndNewlines)
                if !extracted.isEmpty && extracted.count < 35 {
                    merchant = extracted
                    break
                }
            }
        }
        
        return ParsedBankMessage(amount: amount, merchant: merchant, date: Date(), isExpense: isExpense)
    }
    
    private func parseNumber(_ string: String) -> Double? {
        // تحويل الأرقام العربية المشرقية (٠-٩) إلى الإنجليزية إن وجدت
        let arabicMap = ["٠": "0", "١": "1", "٢": "2", "٣": "3", "٤": "4", "٥": "5", "٦": "6", "٧": "7", "٨": "8", "٩": "9"]
        var processed = string
        for (ar, en) in arabicMap {
            processed = processed.replacingOccurrences(of: ar, with: en)
        }
        return Double(processed)
    }
}import Foundation

