    // فلترة المصروفات الخاصة بالشهر الحالي فقط
    var currentMonthExpenses: [MoneyTransaction] {
        let calendar = Calendar.current
        let now = Date()
        return transactions.filter { t in
            t.isExpense && calendar.isDate(t.date, equalTo: now, toGranularity: .month)
        }
    }

    var totalMonthlyExpense: Double {
        currentMonthExpenses.reduce(0) { $0 + $1.amount }
    }

    var body: some View {
        NavigationStack {
            VStack(spacing: 0) {
                BudgetSummaryCard(totalExpense: totalMonthlyExpense, monthlyBudget: monthlyBudget)
                    .padding()
                    .onTapGesture {
                        showingBudgetSettings.toggle()
                    }

                List {
                    Section(header: Text("معاملات الشهر الحالي")) {
                        if currentMonthExpenses.isEmpty {
                            Text("لا توجد مصروفات مسجلة لهذا الشهر حتى الآن.")
                                .foregroundColor(.secondary)
                        } else {
                            ForEach(transactions) { transaction in // تعرض الكل أو currentMonthExpenses حسب رغبتك
                                HStack {
                                    VStack(alignment: .leading, spacing: 4) {
                                        Text(transaction.title)
                                            .font(.headline)
                                        Text(transaction.category)
                                            .font(.caption2)
                                            .padding(.horizontal, 6)
                                            .padding(.vertical, 2)
                                            .background(Color.blue.opacity(0.1))
                                            .foregroundColor(.blue)
                                            .cornerRadius(4)
                                    }
                                    Spacer()
                                    VStack(alignment: .trailing, spacing: 4) {
                                        Text(transaction.amount, format: .currency(code: "SAR"))
                                            .font(.subheadline)
                                            .bold()
                                            .foregroundColor(transaction.isExpense ? .red : .green)
                                        Text(transaction.date, style: .date)
                                            .font(.caption)
                                            .foregroundColor(.secondary)
                                    }
                                }
                            }
                            .onDelete(perform: deleteTransactions)
                        }
                    }
                }
            }
            .navigationTitle("مصروفي")
            .toolbar {
                ToolbarItem(placement: .topBarTrailing) {
                    Button(action: { showingAddView.toggle() }) {
                        Image(systemName: "plus.circle.fill")
                    }
                }
                ToolbarItem(placement: .topBarLeading) {
                    HStack(spacing: 12) {
                        Button(action: { showingImportView.toggle() }) {
                            Image(systemName: "doc.text.magnifyingglass")
                        }
                        Button(action: { showingAnalytics.toggle() }) {
                            Image(systemName: "chart.pie.fill")
                        }
                    }
                }
            }
            .sheet(isPresented: $showingAddView) { AddTransactionView() }
            .sheet(isPresented: $showingImportView) { ImportMessageView() }
            .sheet(isPresented: $showingBudgetSettings) { BudgetSettingsView(monthlyBudget: $monthlyBudget) }
            .sheet(isPresented: $showingAnalytics) { AnalyticsView() }
        }
    }

    private func deleteTransactions(offsets: IndexSet) {
        withAnimation {
            for index in offsets {
                modelContext.delete(transactions[index])
            }
        }
    }
}

struct BudgetSummaryCard: View {
    var totalExpense: Double
    var monthlyBudget: Double

    var progress: Double {
        guard monthlyBudget > 0 else { return 0 }
        return min(totalExpense / monthlyBudget, 1.0)
    }

    var isExceeded: Bool {
        totalExpense > monthlyBudget
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 12) {
            HStack {
                VStack(alignment: .leading, spacing: 4) {
                    Text("المصروفات الشهرية")
                        .font(.subheadline)
                        .foregroundColor(.white.opacity(0.8))
                    Text("\(totalExpense, format: .currency(code: "SAR")) / \(monthlyBudget, format: .currency(code: "SAR"))")
                        .font(.system(size: 20, weight: .bold))
                        .foregroundColor(.white)
                }
                Spacer()
                Image(systemName: isExceeded ? "exclamationmark.triangle.fill" : "checkmark.circle.fill")
                    .font(.system(size: 26))
                    .foregroundColor(isExceeded ? .yellow : .white)
            }

            GeometryReader { geometry in
                ZStack(alignment: .leading) {
                    Rectangle().fill(Color.white.opacity(0.3)).frame(height: 8).cornerRadius(4)
                    Rectangle().fill(isExceeded ? Color.yellow : Color.white)
                        .frame(width: geometry.size.width * CGFloat(progress), height: 8).cornerRadius(4)
                }
            }
            .frame(height: 8)

            if isExceeded {
                Text("⚠️ تنبيه: لقد تجاوزت ميزانية هذا الشهر!")
                    .font(.caption).bold().foregroundColor(.yellow)
            } else {
                Text("المتبقي لشهرك: \((monthlyBudget - totalExpense), format: .currency(code: "SAR"))")
                    .font(.caption).foregroundColor(.white.opacity(0.9))
            }
        }
        .padding()
        .background(isExceeded ? Color.red.opacity(0.9) : Color.accentColor)
        .cornerRadius(16)
    }
}

struct BudgetSettingsView: View {
    @Binding var monthlyBudget: Double
    @Environment(\.dismiss) private var dismiss
    @State private var tempBudget: String = ""

    var body: some View {
        NavigationStack {
            Form {
                Section(header: Text("حدد الميزانية الشهرية الجديدة")) {
                    TextField("الميزانية", text: $tempBudget)
                        .keyboardType(.decimalPad)
                        .onAppear { tempBudget = "\(Int(monthlyBudget))" }
                }
            }
            .navigationTitle("إعدادات الميزانية")
            .toolbar {
                ToolbarItem(placement: .confirmationAction) {
                    Button("حفظ") {
                        let clean = tempBudget.replacingOccurrences(of: ",", with: ".")
                        if let val = Double(clean) {
                            monthlyBudget = val
                        }
                        dismiss()
                    }
                }
                ToolbarItem(placement: .cancellationAction) { Button("إلغاء") { dismiss() } }
            }
        }
    }
}
